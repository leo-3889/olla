# Throwaway 2-stage build for the test/health-feature branch.
#
# The repo's own Dockerfile is single-stage and only wraps a pre-built binary,
# so it cannot be used here: neither this host nor the build host has a Go
# toolchain to produce that binary. This file compiles the Go source inside
# Docker (stage 1) and packages it into a minimal alpine runtime (stage 2),
# mirroring the runtime layout of the repo's Dockerfile so the resulting image
# behaves like the production one.
#
# The permissive Dockerfile.test.dockerignore next to this file (honoured by
# BuildKit for -f docker/Dockerfile.test) keeps the Go source in the build
# context; the repo-root .dockerignore stays production-tight.

# The pre-built dashboard (internal/app/handlers/dashboard/dist) is shipped in
# the build context separately, because it is gitignored and not in the bundle.
# go:embed picks it up at compile time in stage 1.

# ---- Stage 1: compile -------------------------------------------------------
FROM golang:1.24.13-bookworm AS build
# CGO_ENABLED=0 is required: the golang image is glibc-based, but the runtime
# stage is alpine (musl). A cgo build would link against glibc and fail to
# exec on alpine. The repo's own docker build sets this for the same reason.
ENV CGO_ENABLED=0
WORKDIR /src
# Dockerfile.test.dockerignore keeps the context to the Go source plus the
# pre-built dashboard; node_modules is excluded.
COPY . .
# -trimpath keeps the binary reproducible; -s -w strips symbols to shrink it.
RUN go build -trimpath -ldflags "-s -w" -o /app/olla .

# ---- Stage 2: minimal runtime (mirrors the repo Dockerfile) ----------------
FROM alpine:latest
RUN apk --no-cache add ca-certificates tzdata wget && \
    adduser -D -s /bin/sh olla && \
    mkdir -p /app/logs && \
    chown -R olla:olla /app
WORKDIR /app
COPY --from=build /app/olla /usr/local/bin/olla
# Bake in the default config (the loader searches config/config.yaml first).
# Bind to 0.0.0.0 so the test container is reachable on a published port,
# matching the repo's generate-container-config.sh docker flavour.
COPY config/config.yaml config/config.yaml
COPY config/models.yaml config/models.yaml
COPY config/profiles/ config/profiles/
RUN sed -i 's|host: "localhost"|host: "0.0.0.0"|' config/config.yaml && \
    chown -R olla:olla /app
USER olla
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:40114/internal/health || exit 1
EXPOSE 40114
ENTRYPOINT ["olla"]
